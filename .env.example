# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# --- Database (Neon) ---------------------------------------------------------
# Production: Neon *pooled* connection string (host contains "-pooler"),
# e.g. postgres://user:pass@ep-xxx-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full
# Local dev: the PGlite server started by `npm run db:local`.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# --- Auth --------------------------------------------------------------------
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
BETTER_AUTH_SECRET=
# The public URL of the app (https://your-domain in production).
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# One-time token to create the first admin at /setup. Remove it after setup.
SETUP_TOKEN=

# --- Email (Resend, optional) ------------------------------------------------
# Sign-in uses mobile number + password, not email. This only adds email copies of
# alerts and the Monday report; without it they appear in-app only.
RESEND_API_KEY=
EMAIL_FROM="BNI Dheeras <noreply@your-domain.com>"

# --- Images (Neon Object Storage, or any S3-compatible bucket) -------------
# Neon Console → your project → branch → Object storage → New bucket (private is fine:
# the app serves photos itself, to signed-in members only).
# Credentials: Connect → Storage tab → Reveal credential (nak_live_… / nsk_live_…).
# Endpoint looks like https://br-xxxx.storage.c-4.ap-southeast-1.aws.neon.tech
# Check them with: node scripts/check-storage.mjs <bucket>
# Without these, uploads are stored in ./.local-uploads (dev only).
STORAGE_ENDPOINT=
STORAGE_REGION=ap-southeast-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Optional, only for a PUBLIC bucket/CDN: serve images directly from this base URL
# instead of through /api/media (which checks the viewer is a member).
STORAGE_PUBLIC_BASE_URL=

# --- Maps (free: OpenStreetMap) ------------------------------------------------
# Contact email sent to the free OSM Nominatim address search (usage policy).
NOMINATIM_EMAIL=
# Optional: a different map tile server. Defaults to OpenStreetMap.
NEXT_PUBLIC_MAP_TILE_URL=

# --- Scheduled jobs ------------------------------------------------------------
# Vercel sends this as a Bearer token to /api/cron/*.
CRON_SECRET=
